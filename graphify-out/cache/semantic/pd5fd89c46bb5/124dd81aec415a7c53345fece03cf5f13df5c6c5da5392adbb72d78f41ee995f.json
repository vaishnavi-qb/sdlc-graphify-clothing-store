{"nodes": [{"id": "github_steps_token_optimization_10_reading_guide", "label": "Step 10: Add the reading guide", "file_type": "document", "source_file": ".github/steps/token-optimization/10-reading-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_steps_token_optimization_10_reading_guide_token_optimization_md", "label": "docs/TOKEN_OPTIMIZATION.md", "file_type": "concept", "source_file": ".github/steps/token-optimization/10-reading-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One short reference for model selection, prompt habits, and a light monitoring checklist \u2014 habits, not more config files."}, {"id": "github_steps_token_optimization_10_reading_guide_model_selection", "label": "Model selection (cheap default)", "file_type": "rationale", "source_file": ".github/steps/token-optimization/10-reading-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default cheap (Haiku/Flash). Escalate to Sonnet/Opus only when needed \u2014 e.g. hard debugging or auth/payment architecture. Start cheap; if stuck after one focused attempt, escalate and say why."}, {"id": "github_steps_token_optimization_10_reading_guide_stable_volatile_prompts", "label": "Stable-then-volatile prompt ordering", "file_type": "rationale", "source_file": ".github/steps/token-optimization/10-reading-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order prompts for caching: stable project rules first, semi-stable module names by reference, volatile ask last. Prefer 'Show only the changed lines' and naming symbols like paymentController instead of pasting whole files."}], "edges": [{"source": "github_steps_token_optimization_10_reading_guide", "target": "github_steps_token_optimization_1